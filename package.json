{
  "name": "murmuration-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4000 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config test/vitest.config.ts",
    "test:e2e": "node test/run.mjs --config test/playwright.config.ts",
    "test:live": "node test/run.mjs --config test/live.config.ts",
    "setup:https": "node scripts/setup-https.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^4.1.12"
  }
}
